<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lvl_tlo">

    <!-- Górny pasek -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_margin="4dp"
        android:scaleType="fitCenter"
        android:background="@null"
        android:src="@drawable/poziomy_szczalka"
        android:contentDescription="Powrót" />

    <TextView
        android:id="@+id/hintP2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="240dp"
        android:padding="16dp"
        android:background="@drawable/hint_background"
        android:visibility="gone"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_medium"
        android:elevation="4dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center" />



    <LinearLayout
        android:id="@+id/topRightLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <include layout="@layout/top_bar_points" />




    </LinearLayout>




    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp">



        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <!-- Podpowiedzi po lewej -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">

            <ImageButton
                android:id="@+id/podpowiedz1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/plus" />

            <ImageButton
                android:id="@+id/podpowiedz2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/usun_litere" />

            <ImageButton
                android:id="@+id/podpowiedz3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/skip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">


            <ImageButton
                android:id="@+id/podpowiedz4"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wiki_p" />

            <ImageButton
                android:id="@+id/podpowiedz5"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wik_pp" />

            <ImageButton
                android:id="@+id/podpowiedz6"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/a_z" />
        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="320dp">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/answerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            app:flexWrap="wrap"
            app:flexDirection="row"
            app:justifyContent="center"
            android:maxWidth="320dp" />


        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/lettersContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="150dp"
            android:layout_centerHorizontal="true"
            app:flexWrap="wrap"
            app:flexDirection="row"
            app:justifyContent="center"
            android:maxWidth="320dp" />

    </RelativeLayout>


    <ImageButton
        android:id="@+id/btnPrev"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:scaleType="fitCenter"
        android:layout_margin="16dp"
        android:background="@null"
        android:src="@drawable/szczalka_lewo"
        android:contentDescription="Poprzedni" />

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:scaleType="fitCenter"
        android:layout_margin="16dp"
        android:background="@null"
        android:src="@drawable/szczalka_prawo"
        android:contentDescription="Następny" />

    <TextView
        android:id="@+id/hintP1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="240dp"
        android:padding="16dp"
        android:background="@drawable/hint_background"
        android:visibility="gone"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_medium"
        android:elevation="4dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center" />




</RelativeLayout>
