<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lvl_tlo">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/btnBackMenu"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentStart="true"
            android:background="@null"
            android:contentDescription="Powrót"
            android:src="@drawable/poziomy_szczalka"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statystyki"
            android:textColor="#000"
            android:textSize="30sp"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/topRightLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include layout="@layout/top_bar_points" />

        </LinearLayout>
    </RelativeLayout>



    <!-- ScrollView z poziomami -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:padding="0dp">

        <LinearLayout
            android:id="@+id/levelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PRZYKŁADOWE POZIOMY -->


            <RelativeLayout
                android:id="@+id/loga"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/odgadniete_loga"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">

                <!-- Tytuł poziomu -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/statsGuessed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="40dp"
                        android:layout_marginTop="37dp"
                        android:text="0"
                        android:textSize="30sp" />

                </FrameLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/punkty"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/liczba_uzyskanych_punktow"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">

                <!-- Tytuł poziomu -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/statsPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginEnd="40dp"
                        android:layout_marginTop="37dp"
                        android:textColor="#FFFFFF"
                        android:text="0"
                        android:textSize="30sp" />

                </FrameLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/podpowiedzi1"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/liczba_uzytych_podpowiedzi"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">

                <!-- Tytuł poziomu -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/statsUsedHints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginEnd="40dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="37dp"
                        android:text="0"
                        android:textSize="30sp" />

                </FrameLayout>


            </RelativeLayout>

            <!-- dodaj kolejne poziomy analogicznie -->

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
