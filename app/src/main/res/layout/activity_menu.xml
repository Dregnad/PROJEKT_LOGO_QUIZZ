<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_tlo"
    android:padding="0dp">



    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp">

        <ImageView
            android:id="@+id/musicToggleButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="1dp"
            android:layout_marginLeft="350dp"
            android:src="@drawable/volume_sound" />



    </RelativeLayout>

    <LinearLayout
        android:id="@+id/Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logo Quiz"
            android:textSize="70sp"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="0dp"
            android:textColor="#000" />


        <Button
            android:id="@+id/categoryButton"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/graj_tlo"
            android:text="Graj"
            android:textSize="18sp" />


        <Button
            android:id="@+id/button_categories"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/graj_tlo"
            android:text="Kategorie"
            android:textSize="18sp" />

        <Button
            android:id="@+id/button_exit"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/graj_tlo"
            android:text="Wyjdź"
            android:textSize="18sp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="450dp">


        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="100dp"
            android:src="@drawable/ustawienia" />

        <ImageView
            android:id="@+id/btnStatistics"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="260dp"
            android:src="@drawable/statystyki" />

        <ImageView
            android:id="@+id/btnAchievements"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="180dp"
            android:src="@drawable/osiagnecia" />

    </RelativeLayout>

    <ImageView
        android:id="@+id/bottomImage"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitCenter"
        android:src="@drawable/menu_loga" />

</RelativeLayout>
