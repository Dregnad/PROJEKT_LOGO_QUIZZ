<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lvl_tlo"
    android:padding="0dp">



    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp">

        <ImageButton
            android:id="@+id/btnBack2"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentStart="true"
            android:background="@null"
            android:contentDescription="Powrót"
            android:src="@drawable/poziomy_szczalka"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ustawienia"
            android:textColor="#000"
            android:textSize="30sp"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/topRightLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include layout="@layout/top_bar_points" />

        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/volumeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="vertical"
        android:layout_marginTop="-20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume"
            android:textSize="30sp"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="110dp"
            android:textColor="#000" />

        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:max="100"
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sounds"
            android:textSize="30sp"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="20dp"
            android:textColor="#000" />

        <SeekBar
            android:id="@+id/effectsVolumeSeekBar"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:max="100"

            android:layout_below="@id/volumeSeekBar" />



        <ImageButton
            android:id="@+id/btnImage1"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:src="@drawable/ustawienia_reset"
            android:background="@null"
            android:layout_marginTop="40dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:src="@drawable/ustawienia_powrot"
            android:background="@null"
            android:layout_marginTop="30dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Wszystkie logotypy użyte czy zaprezentowane w tej grze są objęte prawami autorskimi i / lub znakami towarowymi odpowiednich podmiotów)"
            android:textSize="8sp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAlignment="center"
            android:textColor="#000" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bottomImage"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitCenter"
        android:src="@drawable/menu_loga" />

</RelativeLayout>
