<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lvl_tlo">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/btnBack1"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentStart="true"
            android:background="@null"
            android:contentDescription="Powrót"
            android:src="@drawable/poziomy_szczalka"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategorie"
            android:textColor="#000"
            android:textSize="30sp"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/topRightLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include layout="@layout/top_bar_points" />

        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:padding="0dp">

        <LinearLayout
            android:id="@+id/kategorieContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Poziom 1 -->
            <RelativeLayout
                android:id="@+id/kat1"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/poziom1"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">

                <TextView
                    android:id="@+id/kat1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Samochody"
                    android:textColor="#000"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kat1Punkty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat1Title"
                    android:layout_marginTop="8dp"
                    android:text="Punkty: 0"
                    android:textColor="#000"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/kat1Loga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat1Title"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:text="Loga: 0/15"
                    android:textColor="#000"
                    android:textSize="26sp" />
            </RelativeLayout>

            <!-- Poziom 2 -->
            <RelativeLayout
                android:id="@+id/kat2"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/poziom1"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/kat2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Napoje"
                    android:textColor="#000"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kat2Punkty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat2Title"
                    android:layout_marginTop="8dp"
                    android:text="Punkty: 0"
                    android:textColor="#000"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/kat2Loga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat2Title"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:text="Loga: 0/15"
                    android:textColor="#000"
                    android:textSize="26sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/kat_lockLayer2"
                android:layout_width="match_parent"
                android:background="#AA000000"
                android:layout_height="145dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="60dp"
                android:visibility="visible"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/kat_lockTitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Napoje"
                        android:textColor="#FFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/kat_lockDesc2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uzyskaj jeszcze 40 punktów, aby odblokować."
                        android:textColor="#FFF"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/kat_lockIcon2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/klodka" />
                </LinearLayout>
            </RelativeLayout>


            <!-- Poziom 3 -->
            <RelativeLayout
                android:id="@+id/kat3"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/poziom1"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/kat3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Gry"
                    android:textColor="#000"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kat3Punkty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat3Title"
                    android:layout_marginTop="8dp"
                    android:text="Punkty: 0"
                    android:textColor="#000"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/kat3Loga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/kat3Title"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:text="Loga: 0/15"
                    android:textColor="#000"
                    android:textSize="26sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/kat_lockLayer3"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="60dp"
                android:background="#AA000000"
                android:visibility="visible"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/kat_lockTitle3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gry"
                        android:textColor="#FFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/kat_lockDesc3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uzyskaj jeszcze 40 punktów, aby odblokować."
                        android:textColor="#FFF"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/kat_lockIcon3"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/klodka" />
                </LinearLayout>
            </RelativeLayout>
            

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
